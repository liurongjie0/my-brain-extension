# ============================================
# Hiking Bot 配置文件
# 复制此文件为 .env 后填写实际值
# ============================================

# ---- 企业微信配置（必填）----
# 企业微信管理后台 -> 我的企业 -> 企业ID
WECHAT_CORP_ID=

# 企业微信应用详情页 -> AgentId
WECHAT_AGENT_ID=

# 企业微信应用详情页 -> Secret
WECHAT_SECRET=

# 企业微信应用 -> 接收消息 -> Token
WECHAT_TOKEN=

# 企业微信应用 -> 接收消息 -> EncodingAESKey
WECHAT_ENCODING_AES_KEY=

# ---- AI 配置（可选，不填则使用内置路线库）----
# AI API Key，支持以下服务商：
#   - OpenAI / DeepSeek / Moonshot（OpenAI chat/completions 格式）
#   - Kimi Coding（Anthropic Messages API 格式，key 以 sk-kimi- 开头）
AI_API_KEY=

# API 基础地址
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Moonshot(国内): https://api.moonshot.cn/v1
# Kimi Coding: https://api.kimi.com/coding/
AI_BASE_URL=https://api.openai.com/v1

# 模型名称
# OpenAI: gpt-4o-mini, gpt-4o
# DeepSeek: deepseek-chat
# Moonshot: moonshot-v1-8k, moonshot-v1-32k, kimi-k2.5
# Kimi Coding: kimi-for-coding
AI_MODEL=gpt-4o-mini

# ---- 应用配置（一般不用改）----
# 对话状态过期时间（秒），默认24小时
CONVERSATION_TTL=86400
